      "name": "Log in (run this folder first)",
      "item": [
        {
          "name": "Login seeded admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"school_id\":\"{{adminSchoolId}}\",\"password\":\"{{demoPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login seeded admin returns 200\", function () { pm.expect(pm.response.code === 200).to.be.true; });",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);",
                  "pm.test(\"admin token is returned\", function () { pm.expect(typeof pm.response.json().token === 'string').to.be.true; });",
                  "pm.collectionVariables.set('adminUserId', String(pm.response.json().user.user_id));"
                ]
              }
            }
          ]
        },
